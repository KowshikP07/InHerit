PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL Connection URL (Use Session or Transaction Pooler)
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# JWT & Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Initial Super Admin Bootstrap Credentials
ADMIN_BOOTSTRAP_EMAIL=admin@campusbid.local
ADMIN_BOOTSTRAP_PASSWORD=YourStrongAdminPassword123!
ADMIN_BOOTSTRAP_NAME="Super Administrator"

# Uploads Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
